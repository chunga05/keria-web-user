# ==============================================================================
# Dear Keria VN (User Web) - Environment Variables Template
# Copy this file to `.env.local` (for local dev) or `.env` / `.env.user` (for production VPS).
# ==============================================================================

# ─── 1. Supabase Configuration ────────────────────────────────────────────────
# URL đầy đủ tới Supabase Project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon Key (Public Key) dùng cho client components
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service Role Key (Secret Key) đặc quyền cao nhất, chỉ dùng trên Server Route Handlers
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── 2. Service URLs, CORS & Server Actions ───────────────────────────────────
# Địa chỉ Dashboard Admin (Dùng cho nút chuyển sang trang Admin từ Header)
# - Local dev: http://localhost:3001
# - Production VPS: https://admin.yourdomain.com
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Địa chỉ Domain công khai của trang User (Khuyên dùng trên VPS để tránh lỗi fallback 0.0.0.0)
# - Local dev: Để trống hoặc comment lại (mặc định lấy theo host / localhost)
# - Production VPS: https://yourdomain.com
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Danh sách domain cho phép Server Actions khi Go-Live (cách nhau bởi dấu phẩy)
# Next.js 16 sẽ từ chối Server Actions nếu host gửi lên không nằm trong danh sách này!
# - Local dev: Để trống hoặc comment lại (mặc định cho phép localhost)
# - Production VPS: yourdomain.com,www.yourdomain.com,admin.yourdomain.com
# ALLOWED_ORIGINS=yourdomain.com,www.yourdomain.com,admin.yourdomain.com

# Cổng chạy ứng dụng (Mặc định: 3000)
PORT=3000

# ─── 3. Redis Cache & Rate Limiting ───────────────────────────────────────────
# Chuỗi kết nối Redis:
# - Local dev: redis://localhost:6379
# - Docker VPS (chung network): redis://redis:6379 hoặc redis://:your_password@redis:6379
REDIS_URL=redis://localhost:6379

# ─── 4. JWT Authentication & Single Sign-On (SSO) ─────────────────────────────
# Secret key dùng để ký và giải mã JWT token (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=your-jwt-secret-at-least-32-chars
USER_JWT_SECRET=your-user-jwt-secret-at-least-32-chars

# Chia sẻ Cookie giữa domain User (yourdomain.com) và Admin (admin.yourdomain.com):
# - Local dev: Để trống hoặc comment lại (mặc định host-only localhost)
# - Production VPS: Bỏ comment và điền domain có dấu chấm ở đầu: .yourdomain.com
# COOKIE_DOMAIN=.yourdomain.com

# ─── 5. Cloudflare R2 / Object Storage (Media Display Only) ───────────────────
# User Web sử dụng cơ chế Presigned URL thông qua Admin API.
# Do đó, User Web KHÔNG CẦN R2_ACCOUNT_ID, R2_ACCESS_KEY_ID hay R2_SECRET_ACCESS_KEY!
# Chỉ cần URL Public của bucket R2 để hiển thị ảnh trên giao diện:
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your-bucket.r2.dev

# ==============================================================================
# 6. FEATURE FLAGS (CHẾ ĐỘ TÍNH NĂNG ĐANG PHÁT TRIỂN / UNDER CONSTRUCTION)
# ==============================================================================
# Điều khiển bật/tắt các tính năng đang trong quá trình phát triển (WIP).
# Giá trị hỗ trợ: "true", "false", "1", "0" (mặc định an toàn là false nếu thiếu).
# - Production: Để false cho các tính năng chưa hoàn thiện để hiển thị trang "Đang phát triển".
# - Dev / Test: Đổi thành true để kiểm thử giao diện và chức năng.
# ==============================================================================

# Lịch trình Keria (Route: /kerias/lich-trinh)
# Mặc định: false (Đang phát triển)
NEXT_PUBLIC_ENABLE_SCHEDULE=false

# Dự án đặc biệt 'Welcome to Vietnam' (Route: /project/welcome-to-vietnam)
# Mặc định: false (Đang phát triển)
NEXT_PUBLIC_ENABLE_WELCOME_PROJECT=false

# Stream Donations & Leaderboard (Route: /stream-donation)
# Mặc định: true
NEXT_PUBLIC_ENABLE_STREAM_DONATION=true

# Sổ tay hành trình (Route: /hoat-dong/so-tay-hanh-trinh)
# Mặc định: false (Đang phát triển)
NEXT_PUBLIC_ENABLE_HANDBOOK=false

# Thành tích Keria (Route: /thanh-tich)
# Mặc định: false (Đang phát triển)
NEXT_PUBLIC_ENABLE_ACHIEVEMENTS=false

# Supporting Project (Route: /content)
# Mặc định: false (Đang phát triển)
NEXT_PUBLIC_ENABLE_SUPPORTING_PROJECT=false

# Tường Lời nhắn chúc mừng (Route: /hoat-dong/loi-nhan)
# Mặc định: true
NEXT_PUBLIC_ENABLE_WISHES=true

# Demo Feature Flag (cho mục đích test)
# Mặc định: false
NEXT_PUBLIC_ENABLE_DEMO_FEATURE=false
